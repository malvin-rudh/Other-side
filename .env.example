# Local-only credentials for scripts/generate-saved-answers.ts.
# Copy to .env (gitignored) and fill in. Never commit real values.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Server-only settings for server/ (read from process.env, never VITE_*).
# DEMO_TOKEN is typed by the evaluator and compared in constant time.
DEMO_TOKEN=
# LIVE_ENABLED=true turns on the live Qwen path; anything else serves LIVE_DISABLED.
LIVE_ENABLED=false
# Exact frontend origin for CORS headers; empty sends no CORS headers.
ALLOWED_ORIGIN=http://localhost:5173
# Structured output mode: json_schema or json_object; empty probes at startup.
QWEN_STRUCTURED_MODE=

# Optional market-data provider adapter (server/quotes.ts). Quotes are a separate
# surface from the historical replay and are never merged into a broker snapshot.
# QUOTE_ENABLED=true turns the adapter on; anything else answers DISABLED and the
# UI reports an honest unavailable state. Yahoo needs no key, so nothing secret
# is configured here; swap the base URLs to point at a licensed vendor.
QUOTE_ENABLED=false
QUOTE_CHART_BASE_URL=https://query1.finance.yahoo.com
QUOTE_SEARCH_BASE_URL=https://query2.finance.yahoo.com
QUOTE_TIMEOUT_MS=8000
